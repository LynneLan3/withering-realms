---
/**
 * Site-wide Adsterra Social Bar / global Profitablerate script.
 * Production-only. Hostname check skips non-production hosts.
 */
import {
	ADSTERRA_SITE_URL,
	ADSTERRA_SOCIAL_BAR_SRC,
	isAdsterraSocialBarRuntimeEnabled,
} from './ads/adsterra';

const enabled = isAdsterraSocialBarRuntimeEnabled();
const siteHost = enabled ? new URL(ADSTERRA_SITE_URL).hostname : '';
const scriptSrc = ADSTERRA_SOCIAL_BAR_SRC;
---

{
	enabled && (
		<script is:inline define:vars={{ scriptSrc, siteHost }}>
			(function () {
				try {
					if (location.hostname !== siteHost) return;
				} catch (error) {
					return;
				}
				if (document.querySelector('script[data-gw-social-bar]')) return;
				var script = document.createElement('script');
				script.async = true;
				script.setAttribute('data-cfasync', 'false');
				script.setAttribute('data-gw-social-bar', '');
				script.src = scriptSrc;
				document.head.appendChild(script);
			})();
		</script>
	)
}
