---
import '../styles/bolt-realms.css';

interface Props {
	title: string;
	description?: string;
	canonicalPath?: string;
	robots?: string;
	ogImage?: string;
}

const {
	title,
	description = 'Unofficial Early Access field guide for Withering Realms — Penwyll puzzles, doll arms, night routes, and perimeter guardians.',
	canonicalPath = '/',
	robots = 'index,follow',
	ogImage = '/assets/images/screenshots/screenshot_city.jpg',
} = Astro.props;

const site = Astro.site ?? new URL('https://withering-realms.vercel.app/');
const canonical = new URL(canonicalPath.replace(/^\//, ''), site).href;
const og = new URL(ogImage.replace(/^\//, ''), site).href;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={og} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={og} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
	</head>
	<body>
		<div class="app-shell">
			<div class="atmosphere atmosphere-top"></div>
			<slot />
		</div>
	</body>
</html>
