---
import generated from '../v4/generated/example-site.json';
import RealmsShell from '../presentation/RealmsShell.astro';
import RealmsHeader from '../presentation/RealmsHeader.astro';
import RealmsFooter from '../presentation/RealmsFooter.astro';
import { icon } from '../presentation/icons';
import { PLAYER_TASK_LABELS, type PlayerTask } from '../v4/intent-contract';

const searchable = generated.pages.map((page) => ({
	...page,
	type: PLAYER_TASK_LABELS[page.pageData.intent.primaryTask as PlayerTask],
}));
const initialQuery = Astro.url.searchParams.get('q') ?? '';
---
<RealmsShell
	title={`Search · ${generated.game.name}`}
	description={`Search the ${generated.game.name} field guide.`}
	canonicalPath="/search/"
>
	<RealmsHeader variant="solid" currentPath="/search/" />
	<main class="article-page page-width" data-v4-search-page>
		<div class="article-breadcrumb">
			<a href="/"><span set:html={icon.arrowLeft}></span> Home</a>
			<span>/</span>
			<span>Search</span>
		</div>
		<section class="search-band" style="width: 100%; margin-bottom: 40px;">
			<div>
				<span class="section-kicker">Lost in Penwyll?</span>
				<h2>Search the <em>casebook</em></h2>
			</div>
			<form class="search-box" role="search" style="width: min(430px, 100%);">
				<span set:html={icon.searchLg}></span>
				<input id="v4-search-input" name="q" type="search" value={initialQuery} placeholder="Try “Birdcage”, “gaps”, or “bells”" />
				<kbd>⌘ K</kbd>
			</form>
		</section>
		<p class="empty-state" aria-live="polite" data-v4-search-status>{searchable.length} indexed answers</p>
		<section class="guide-grid" aria-label="Search results" style="margin-top: 28px;">
			{searchable.map((item) => (
				<a
					class="guide-card"
					href={item.href}
					data-search-text={`${item.title} ${item.type} ${item.pageData.intent.query} ${item.pageData.intent.playerProblem}`}
				>
					<div class="guide-thumb">
						<img src="/assets/images/screenshots/screenshot_city.jpg" alt="" />
					</div>
					<div class="guide-details">
						<span class="guide-category">{item.type}</span>
						<h3>{item.title}</h3>
						<div class="guide-meta">
							<span>{item.pageData.intent.playerProblem}</span>
						</div>
					</div>
					<span set:html={icon.chevronRightGuide}></span>
				</a>
			))}
		</section>
	</main>
	<RealmsFooter />
</RealmsShell>
<script is:inline>
const f = document.querySelector('form');
const i = document.querySelector('#v4-search-input');
const s = document.querySelector('[data-v4-search-status]');
const a = [...document.querySelectorAll('[data-search-text]')];
const run = () => {
	const q = (i?.value || '').trim().toLowerCase();
	let n = 0;
	a.forEach((x) => {
		const v = !q || (x.dataset.searchText || '').toLowerCase().includes(q);
		x.hidden = !v;
		if (v) n += 1;
	});
	if (s) s.textContent = n + ' result' + (n === 1 ? '' : 's');
};
f?.addEventListener('submit', (e) => { e.preventDefault(); run(); });
i?.addEventListener('input', run);
run();
</script>
